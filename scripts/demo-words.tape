
Output docs/demo-words.gif

Set Shell "zsh"
Set FontSize 20
Set Width 1400
Set Height 760
Set Padding 24
Set TypingSpeed 70ms
Set Theme "Catppuccin Mocha"

Hide
Type "NVIM_APPNAME=writing-dev nvim -u init.lua .scratch/demo-words.md"
Enter
Sleep 2s
Show

Type "iShe looked at the old photos with a deep sense of "
Escape
Sleep 1s
Escape
Type "$"
Sleep 1s

Type " lw"
Sleep 1.5s
Type "a feeling of longing for the past"
Sleep 1s
Enter
Sleep 7s
Sleep 1.5s
Enter
Sleep 2.5s
Escape
Sleep 1s

Type " lk"
Sleep 1.5s
Type "nostalgia"
Sleep 4s
Escape
Sleep 1.5s
